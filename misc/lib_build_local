set -u

# doc_get_main DC-file
function doc_get_main()
{
    local dc_file="$1"
    (awk -F= '/^ *MAIN=/ {print $2}' |  tr -d '"') < "$dc_file"
}

# doc_init doc_name - takes (or sets) Gfmt; sets Gdir, Gpdf, GtimeStamp, Goutdir
function doc_init()
{
    local doc_name="$1"
    Gdir="$PWD"
    if [[ -z "$Gfmt" ]]; then
        Gfmt="pdf"
    fi
    Gpdf="${doc_name}_${Gflavour}en.$Gfmt"
    GtimeStamp="$(date +'%Y%m%d-%H%M')"
    Goutdir="$(mktemp -d -p /tmp daps2docker-fh-XXXXXXXX)" 
}

# doc_build dc-file # - takes global vars: Gpdf, Gdir, Gfmt, GtimeStamp
function doc_build()
{
    local dc="$1"
    touch build/"$Gpdf"
    daps2docker.sh --outputdir="$Goutdir" "$Gdir/$dc" "$Gfmt" ; rc=$?
    return "$rc"
}

function doc_fetch()
{
    mkdir -p build
    echo "---------------- $Goutdir --------------"
    if [[ -e "$Goutdir" && -e ""$Goutdir"/filelist" ]]; then
        ls -l "$Goutdir"
        files=$(cat "$Goutdir"/filelist)
        #mv -v $files build
        ls -l $files
        echo "files: $files"
        echo "PWD: $PWD"
        cp $files build
        (cd build; echo "BUILD: $PWD" ; ls -l *)
        #find /tmp/daps2docker* \
        #          -name "$Gpdf" \
        #          -newer build/"$Gpdf" \
        #          -exec mv {} build \; -print
        return 0
    else
        return 2
    fi
}

function doc_error_exit()
{
    echo "$@"
    exit 2
}

# doc_make list-of-DCs
function doc_make()
{
    local dcNr i main
    dcNr=$(echo "$dcs" | wc -l)
    i=0
    Gflavour=""
    for dc in $@; do
        main=$(doc_get_main "$dc")    
        doc_name="${main%.adoc}"
        # echo "main=$main dc_name=$dc_name"
        # draft only for pdf format
        if [[ "$Gfmt" == "pdf" ]]; then
            if grep -q '^DRAFT=yes' "$dc"; then
                Gflavour="draft_"
            fi
        fi
        (( i++ ))
        GstdDc="$dc"
        echo "building $GstdDc ($i / $dcNr)"
        doc_init "$doc_name"
        doc_build "$dc" || doc_error_exit "FAILED BUILD: ($i / $dcNr) - $GstdDc"
        doc_fetch
        Gpdfs="$pdfs build/${Gpdf}"
        echo "$Gfmt: build/${Gpdf}"
    done
}
